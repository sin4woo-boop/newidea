# Auth.js / NextAuth
AUTH_SECRET=replace-with-32-plus-random-chars
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# Demo DB (Prisma + SQLite)
DATABASE_URL="file:./dev.db"

# Google Vision OCR credentials
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}
# or file path mode
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json

# Optional: Supabase Storage for uploaded images
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_STORAGE_BUCKET=uploads
